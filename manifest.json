{
  "manifest_version": 3,
  "name": "PromptShield - PII Scrubber (Prototype)",
  "version": "0.1.0",
  "description": "Detects and redacts PII in web text inputs before sending prompts to chat AIs.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://you.com/*",
    "https://poe.com/*",
    "https://huggingface.co/chat/*",
    "https://chat.mistral.ai/*",
    "https://chat.lmsys.org/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptShield",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://you.com/*",
        "https://poe.com/*",
        "https://huggingface.co/chat/*",
        "https://chat.mistral.ai/*",
        "https://chat.lmsys.org/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
